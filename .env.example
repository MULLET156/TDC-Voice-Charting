# Settings for TDC Voice Charting. Copy this file to .env and fill it in.
# Never commit .env, and never paste these values into email, chat or GitHub.

# design (Hostinger, Open Dental demo database) or live (office server)
TDC_STAGE=design

# Port. On Hostinger leave PORT out (Hostinger sets it). Office server: 3103.
PORT=3103
# 127.0.0.1 on the office server (required in the live stage). 0.0.0.0 on Hostinger.
HOST=127.0.0.1

# Paste the secret shown in Dashboard -> Settings -> Modules after adding "voice".
MODULE_SECRET=

# The Open Dental gateway and this module's own key (made with: node gateway/cli.js new-key voice).
# Building on a laptop with the fake demo gateway (npm run dev in opendental-claude):
#   GATEWAY_URL=http://127.0.0.1:8787  and  GATEWAY_KEY=odg_test_voice_key_0003
GATEWAY_URL=http://127.0.0.1:8787
GATEWAY_KEY=

# Ryan's Anthropic API key (Claude makes the drafts).
ANTHROPIC_API_KEY=

# Design stage with the demo database: Confirm writes only to these patients.
# 8133 = Ryan A. Millet (test patient). Ignored in the live stage.
WRITE_PATNUMS=8133

# Where drafts, history and settings are kept. On Hostinger use a folder outside
# the app folder so they survive deploys, e.g. ~/tdc-voice-data
DATA_DIR=data

# Drafts nobody confirms are deleted after this many hours.
DRAFT_HOURS=72

# The office's time zone (for "today").
TZ=America/Los_Angeles
